# Environment
ENVIRONMENT=development

# Server
SERVER_PORT=8080

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Cache Settings
CACHE_TTL_SECS=3600

# Logging
RUST_LOG=info,ev_api=debug,ev_graph=debug
